# Neon Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Basic auth credentials (single-user)
AUTH_USER="your-username"
AUTH_PASS="your-password"
# At least 32 characters; used to sign session cookies.
AUTH_SECRET="generate-a-long-random-session-signing-secret"

# Optional read-only guest account. When enabled, signing in with the username
# "guest" and this password grants a session that can view everything except
# notes and cannot change data. The owner username must not be "guest".
# AUTH_GUEST_ENABLED="true"
# AUTH_GUEST_PASS="a-separate-guest-password"
